# Model providers use OpenAI-compatible APIs. Keep secrets server-side.
MODEL_PROVIDER=mock
MODEL_BASE_URL=https://api.deepseek.com
MODEL_API_KEY=
MODEL_NAME=deepseek-chat

# Alternative Alibaba Bailian / Qwen endpoint:
# MODEL_PROVIDER=qwen
# MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MODEL_NAME=qwen3-max
#
# If the Bailian console provides a workspace-specific endpoint, use it instead:
# MODEL_BASE_URL=https://llm-YOUR_WORKSPACE.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

PORT=8787
DATABASE_PATH=./data/agri.db
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_TIMEOUT_MS=6000
SOILGRIDS_TIMEOUT_MS=4500
# Task-specific model routing. All use the configured regional endpoint and key.
MODEL_SUMMARY_NAME=qwen3-max
MODEL_VISION_NAME=qwen3-vl-plus
# Set true only for demonstrations that deliberately slow down trace playback.
AGENT_DEMO_DELAYS=false
# DASHSCOPE_API_KEY is also accepted when MODEL_API_KEY is absent.

# AMap Web JS API: security code stays on the local API service.
AMAP_JS_KEY=
AMAP_SECURITY_CODE=
