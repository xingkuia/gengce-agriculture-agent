{
  "name": "gengce-agriculture-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "desktop/main.cjs",
  "productName": "耕策",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "tsx watch --clear-screen=false server/index.ts",
    "build": "pnpm build:web && pnpm build:server",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "desktop": "pnpm build && electron desktop/main.cjs",
    "desktop:package": "pnpm soil:prepare && pnpm build && node scripts/package-desktop.mjs",
    "start": "node dist-server/index.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.server.json --noEmit --pretty false",
    "check:ui": "node scripts/browser-check.mjs",
    "check:desktop": "node scripts/electron-check.mjs",
    "check:model": "node scripts/check-model.mjs",
    "db:seed:public": "tsx scripts/seed-public-guidance.ts",
    "soil:download": "node scripts/download-hubei-soil.mjs",
    "soil:prepare": "node scripts/prepare-soil-runtime.mjs"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "electron": "^45.2.3",
    "geotiff": "^3.0.5",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "packageManager": "pnpm@11.25.0",
  "dependencies": {
    "@mastra/core": "1.83.0",
    "@mastra/mcp": "2.9.0",
    "@mastra/rag": "2.8.0",
    "zod": "4.2.0"
  }
}
